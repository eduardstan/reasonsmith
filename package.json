{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "reasonsmith",
  "description": "Reasonsmith — the OpenTUI renderer, terminal-control recording harness, and a thin CLI launcher. The Python reasonsmith package (`src/reasonsmith/`) is the only source of truth for packs, engines, and systems.",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "bun turbo typecheck",
    "test": "bun turbo test",
    "dev:tui": "bun run --cwd packages/tui dev",
    "record:tui": "bash scripts/record-tui.sh",
    "install-skill": "bun run --cwd packages/terminal-control install-skill",
    "lint": "bun turbo lint"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@opentui/core": "0.6.1",
      "@opentui/solid": "0.6.1",
      "@tsconfig/bun": "1.0.11",
      "solid-js": "1.9.17",
      "typescript": "5.8.2",
      "@types/bun": "1.4.2"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "eslint": "9.39.5",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1"
  },
  "license": "MIT"
}
